# SharedJournal local environment template
# Copy this file to .env.local and fill in real values.
# Do not commit real secrets.

# ------------------------------------------------------------
# Required: Clerk authentication
# ------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# ------------------------------------------------------------
# Required: Database (Neon/PostgreSQL)
# ------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/neondb?sslmode=require

# ------------------------------------------------------------
# Required: Entry encryption (must decode to exactly 32 bytes)
# Generate with: openssl rand -base64 32
# ------------------------------------------------------------
ENTRY_CONTENT_ENCRYPTION_KEY=replace_with_base64_32_byte_key

# ------------------------------------------------------------
# Required: App URL used in generated links
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional server-side fallback URL for invite link generation
APP_URL=http://localhost:3000

# ------------------------------------------------------------
# Optional: Vercel Blob upload support
# ------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace_me

# ------------------------------------------------------------
# Optional: Invite email provider (Resend)
# Set INVITE_EMAIL_PROVIDER=none to disable email sending.
# ------------------------------------------------------------
INVITE_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL=SharedJournal <invites@notify.sharedjournal.app>

# ------------------------------------------------------------
# Optional: Stripe support payments
# ------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ------------------------------------------------------------
# Optional: LaunchDarkly feature flags
# ------------------------------------------------------------
LAUNCHDARKLY_SDK_KEY=sdk-replace-me
NEXT_PUBLIC_LAUNCHDARKLY_CLIENT_SIDE_ID=replace_me

# Optional local override for entry-comments flag (true/false)
LAUNCHDARKLY_FLAG_ENTRY_COMMENTS=

# ------------------------------------------------------------
# Optional: Meticulous session recording
# ------------------------------------------------------------
METICULOUS_RECORDING_TOKEN=replace_me
NEXT_PUBLIC_METICULOUS_RECORDING_TOKEN=replace_me

# ------------------------------------------------------------
# Optional: Auth UX
# ------------------------------------------------------------
NEXT_PUBLIC_ENABLE_GOOGLE_ONE_TAP=false

# ------------------------------------------------------------
# Optional: Content moderation
# CONTENT_MODERATION_ENABLED must be exactly true to enforce moderation.
# CONTENT_MODERATION_FAIL_MODE options:
# - open   (default): allow writes when provider fails
# - closed          : block writes when provider fails
# ------------------------------------------------------------
CONTENT_MODERATION_ENABLED=false
CONTENT_MODERATION_PROVIDER=openai
CONTENT_MODERATION_API_KEY=sk_replace_me
CONTENT_MODERATION_FAIL_MODE=open

# ------------------------------------------------------------
# Optional: E2E test account credentials (Playwright)
# ------------------------------------------------------------
E2E_CLERK_EMAIL=test-user@example.com
E2E_CLERK_PASSWORD=replace_me
